# Required: Postgres connection string (RDS or local).
# Use postgresql:// or postgresql+psycopg2://
DATABASE_URL=postgresql://catan:password@localhost:5432/catan

# Required for auth (login/signup and JWT validation): Amazon Cognito
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only if the app client is confidential
# COGNITO_CLIENT_SECRET=
# Optional: local Cognito emulator only (see docker-compose.yml / local/).
# Leave unset to use the real AWS endpoint and the pool's JWKS.
# COGNITO_ENDPOINT_URL=http://localhost:5001
# COGNITO_JWKS_URL=http://localhost:5001/<pool_id>/.well-known/jwks.json

# Optional: development (default) or production. Production requires email
# confirmation on signup; development auto-confirms (the emulator sends no mail).
# ENVIRONMENT=development

# Optional: browser origins allowed to call the API cross-origin (comma-separated).
# Needed only when the Vite dev server talks to this backend directly; leave unset
# behind the compose edge or CloudFront, where the API is same-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: proxies in front of the app that append to X-Forwarded-For, used to
# find the client IP for rate limiting. 0 direct (default), 1 nginx edge, 2 CloudFront + ALB.
# TRUSTED_PROXY_HOPS=0
