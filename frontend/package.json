{
  "name": "catan-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "BROWSER=\"Google Chrome\" vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.24",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0"
}
