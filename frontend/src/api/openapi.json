{
  "openapi": "3.1.0",
  "info": {
    "title": "Catan Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Liveness check for the service.\n\nReturns:\n    HealthResponse with status \"ok\".",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Log in with email and password via Cognito.\n\nArgs:\n    payload: Login request containing email and password.\n    db: Database session (injected dependency).\n\nReturns:\n    Session tokens and user identity.\n\nRaises:\n    HTTPException: 400 if login fails; 429 when rate limited; 503 if Cognito is not configured.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signup",
        "description": "Sign up with email and optional username via Cognito.\n\nArgs:\n    payload: Signup request containing email, password, and optional username.\n    db: Database session (injected dependency).\n\nReturns:\n    Whether email confirmation is pending, plus a session when it is not.\n\nRaises:\n    HTTPException: 400 if signup fails; 429 when rate limited; 503 if Cognito is not configured.",
        "operationId": "signup_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthSignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSignupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/confirm": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Confirm",
        "description": "Confirm a signup with the code Cognito emailed.\n\nArgs:\n    payload: Email and confirmation code.\n\nReturns:\n    Acknowledgement; log in afterwards.\n\nRaises:\n    HTTPException: 400 if the code is wrong or expired; 429 when rate limited.",
        "operationId": "confirm_auth_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/resend-confirmation": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Resend Confirmation",
        "description": "Email a fresh confirmation code.\n\nArgs:\n    payload: Email used at signup.\n\nReturns:\n    Acknowledgement, identical whether or not the account exists.\n\nRaises:\n    HTTPException: 400 on a Cognito error; 429 when rate limited.",
        "operationId": "resend_confirmation_auth_resend_confirmation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthResendConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "description": "Refresh an access token using a Cognito refresh token.\n\nArgs:\n    payload: Refresh request.\n    db: Database session (injected dependency).\n\nReturns:\n    New session tokens.\n\nRaises:\n    HTTPException: 400 if refresh fails; 429 when rate limited; 503 if Cognito is not configured.",
        "operationId": "refresh_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Revoke the refresh token and sign out the current session.\n\nthe bearer token is optional and not validated: an expired access token\nmust still be able to log out.\n\nArgs:\n    payload: Refresh token to revoke.\n    authorization: Optional \"Bearer <token>\" header.\n\nReturns:\n    Acknowledgement.\n\nRaises:\n    HTTPException: 429 when rate limited; 503 if Cognito is not configured.",
        "operationId": "logout_auth_logout_post",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLogoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get User",
        "description": "Get a user by UUID.\n\nprofiles are created by signup and login; there is no public create route.\n\nArgs:\n    user_id: User UUID as string (from path parameter).\n    current_user: Authenticated user (injected dependency).\n    db: Database session (injected dependency).\n\nReturns:\n    User profile as UserRead schema.\n\nRaises:\n    HTTPException: 403 if trying to access another user's profile.\n    HTTPException: 404 if user not found.\n\nNote:\n    Requires Authorization header with a valid Cognito access token.\n    Users can only access their own profile.",
        "operationId": "get_user_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session For User",
        "description": "Create a game session for a user.\n\nArgs:\n    user_id: User UUID as string (from path parameter).\n    payload: Game session creation data containing optional initial state.\n    current_user: Authenticated user (injected dependency).\n    db: Database session (injected dependency).\n\nReturns:\n    Created game session as GameSessionRead schema.\n\nRaises:\n    HTTPException: 403 if trying to create session for another user.\n    HTTPException: 404 if user not found.\n\nNote:\n    Requires Authorization header with a valid Cognito access token.\n    Users can only create their own sessions.",
        "operationId": "create_session_for_user_users__user_id__sessions_post",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameSessionCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSessionRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "List Sessions For User",
        "description": "List game sessions for a user, newest first.\n\nArgs:\n    user_id: User UUID as string (from path parameter).\n    current_user: Authenticated user (injected dependency).\n    db: Database session (injected dependency).\n\nReturns:\n    List of game sessions as GameSessionRead schemas, ordered by created_at descending.\n\nRaises:\n    HTTPException: 403 if trying to access another user's sessions.\n\nNote:\n    Requires Authorization header with a valid Cognito access token.\n    Users can only list their own sessions.",
        "operationId": "list_sessions_for_user_users__user_id__sessions_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameSessionRead"
                  },
                  "title": "Response List Sessions For User Users  User Id  Sessions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthConfirmRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "code": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "title": "AuthConfirmRequest",
        "description": "Request body for POST /auth/confirm.\n\nAttributes:\n    email: Email used at signup.\n    code: Verification code Cognito emailed to that address."
      },
      "AuthLoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "AuthLoginRequest",
        "description": "Request body for POST /auth/login.\n\nAttributes:\n    email: User email address.\n    password: User password."
      },
      "AuthLogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "AuthLogoutRequest",
        "description": "Request body for POST /auth/logout.\n\nAttributes:\n    refresh_token: Refresh token to revoke. its access tokens stop working too."
      },
      "AuthMessageResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AuthMessageResponse",
        "description": "Acknowledgement for auth actions that return no session.\n\nAttributes:\n    message: Human-readable outcome."
      },
      "AuthRefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "AuthRefreshRequest",
        "description": "Request body for POST /auth/refresh.\n\nAttributes:\n    refresh_token: Cognito refresh token from a prior login/signup.\n    username: Cognito username (email) required when the app client has a secret."
      },
      "AuthResendConfirmationRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "AuthResendConfirmationRequest",
        "description": "Request body for POST /auth/resend-confirmation.\n\nAttributes:\n    email: Email used at signup."
      },
      "AuthSessionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token",
            "default": ""
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "AuthSessionResponse",
        "description": "Session payload returned by login, signup, and refresh.\n\nAttributes:\n    access_token: Cognito access token (send as Authorization: Bearer).\n    refresh_token: Cognito refresh token.\n    expires_in: Access token lifetime in seconds.\n    token_type: Token type, always Bearer.\n    user: Identity claims for the authenticated user.\n    message: Optional note (e.g. email confirmation required)."
      },
      "AuthSignupRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "AuthSignupRequest",
        "description": "Request body for POST /auth/signup.\n\nAttributes:\n    email: User email address.\n    password: User password.\n    username: Optional display name stored on the Cognito user."
      },
      "AuthSignupResponse": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "confirmation_required": {
            "type": "boolean",
            "title": "Confirmation Required"
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthSessionResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "email",
          "confirmation_required"
        ],
        "title": "AuthSignupResponse",
        "description": "Payload returned by signup.\n\nAttributes:\n    email: Address the account was created for.\n    confirmation_required: True when Cognito emailed a verification code and\n        the client must call /auth/confirm before logging in.\n    session: Session tokens, only when the account was confirmed at once\n        (local development against the emulator)."
      },
      "AuthUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "AuthUser",
        "description": "Authenticated user identity returned with a session.\n\nAttributes:\n    id: Cognito user UUID (`sub`).\n    email: User email if present on the token.\n    username: Display name if present on the token."
      },
      "GameSessionCreate": {
        "properties": {
          "state": {
            "additionalProperties": true,
            "type": "object",
            "title": "State",
            "description": "Serialized Catan game state."
          }
        },
        "type": "object",
        "title": "GameSessionCreate",
        "description": "Payload to create a game session (optional initial state).\n\nAttributes:\n    state: Serialized Catan game state as dictionary (inherited from GameSessionBase)."
      },
      "GameSessionRead": {
        "properties": {
          "state": {
            "additionalProperties": true,
            "type": "object",
            "title": "State",
            "description": "Serialized Catan game state."
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "created_at",
          "updated_at"
        ],
        "title": "GameSessionRead",
        "description": "Game session as returned by the API (read-only fields).\n\nAttributes:\n    id: Game session ID (primary key).\n    user_id: User UUID who owns the session.\n    state: Serialized Catan game state as dictionary (inherited from GameSessionBase).\n    created_at: Timestamp when the session was created.\n    updated_at: Timestamp when the session was last updated."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "description": "Liveness payload for GET /health.\n\nAttributes:\n    status: Service status string."
      },
      "UserRead": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "email",
          "id",
          "created_at"
        ],
        "title": "UserRead",
        "description": "User as returned by the API (read-only fields).\n\nAttributes:\n    id: User UUID (primary key).\n    email: User email address (inherited from UserBase).\n    created_at: Timestamp when the user was created."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
